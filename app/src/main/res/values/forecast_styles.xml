<resources>
    <style name="ForecastText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:shadowColor">#6607152C</item>
        <item name="android:shadowRadius">10</item>
        <item name="android:shadowDy">2</item>
    </style>
    <style name="ForecastControl" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">#66FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>
    <style name="ForecastIconControl" parent="ForecastControl">
        <item name="android:padding">12dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
    </style>
</resources>
