<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/app_title" style="@style/ForecastText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/brand_label"
            android:letterSpacing="0.14" android:textColor="#D8E8FA" android:textSize="11sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/motion_button"
            style="@style/ForecastIconControl" android:layout_width="44dp" android:layout_height="44dp"
            android:minWidth="44dp" android:layout_marginEnd="6dp"
            android:contentDescription="@string/pause_motion" app:icon="@drawable/ic_motion_pause" />
        <com.google.android.material.button.MaterialButton android:id="@+id/week_button"
            style="@style/ForecastIconControl" android:layout_width="44dp" android:layout_height="44dp"
            android:minWidth="44dp" android:layout_marginEnd="6dp"
            android:contentDescription="@string/week_outlook" app:icon="@drawable/ic_week" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh_button"
            style="@style/ForecastIconControl" android:layout_width="44dp" android:layout_height="44dp"
            android:minWidth="44dp" android:contentDescription="@string/refresh" app:icon="@drawable/ic_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView style="@style/ForecastText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/location_title" android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />
        <TextView style="@style/ForecastText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/austin_local" android:textColor="#C6DEEE" android:textSize="11sp" android:letterSpacing="0.04" />
    </LinearLayout>
    <TextView android:id="@+id/status_text" style="@style/ForecastText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="11sp" android:textColor="#CADBED"
        android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/loading_indicator" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_marginTop="6dp" android:indeterminate="true"
        android:indeterminateTint="#F6CEB5" android:visibility="invisible" />
</LinearLayout>
