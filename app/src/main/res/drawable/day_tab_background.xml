<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient android:startColor="#30FFFFFF" android:endColor="#08FFFFFF" android:angle="270" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#22FFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>
